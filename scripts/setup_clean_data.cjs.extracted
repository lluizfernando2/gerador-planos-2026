405 | function escapeHtml(a: any): string {
406 | return a == null ? "" : String(a).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/
g, "&quot;")....	407 | }
408 |
409 | function normalizeStr(a: string): string {
410 | return a.toLowerCase().normalize("NFD").replace(/[\\u0300-\\u036f]/g, "").replace(/[^a-z0-9]/g, "");
411 | }
